&control
    calculation = 'relax'
    prefix = 'cunipt'
    pseudo_dir = '.'
    outdir = "."
    restart_mode = 'restart'
/

&system
    ibrav = 2
    celldm(1) = 10.89
    nat = 3
    ntyp = 3
    ecutwfc = 60
    ecutrho = 240
    nbnd = 28
    occupations = 'smearing'
    smearing = 'gaussian'
    degauss = 0.01
    assume_isolated = 'martyna-tuckerman'
/

&electrons
    conv_thr = 1.0d-7,
    mixing_beta = 0.7,
    
/
&IONS
/
ATOMIC_SPECIES
Cu 63.546 Cu.upf
 Ni 58.693 Ni.upf
 Pt 195.08 Pt.upf

ATOMIC_POSITIONS {alat}
 Cu 0.0 0.0 0.0
 Ni 0.5 0.5 0.5
 Pt 0.25 0.25 0.25
 
K_POINTS Gamma                            
