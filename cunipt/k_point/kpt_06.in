 &control
    calculation = 'scf',
    prefix = 'cunipt'
    outdir = './.'
    pseudo_dir = './.'
 /
 &system
    ibrav =  2,
    celldm(1) = 10.89,
    nat =  3,
    ntyp = 3,
    ecutwfc = 60.0
    occupations = 'smearing'
     smearing = 'gaussian',
    degauss = 0.01
 /
 &electrons
    mixing_beta = 0.6
 /
 
ATOMIC_SPECIES
 Cu 63.546 Cu.upf
 Ni 58.693 Ni.upf
 Pt 195.08 Pt.upf

ATOMIC_POSITIONS {alat}
 Cu 0.0 0.0 0.0
 Ni 0.5 0.5 0.5
 Pt 0.25 0.25 0.25
 
 K_POINTS automatic 
06 06 06 1 1 1
