&control
    calculation = 'scf'
    prefix = 'cunipt'
    pseudo_dir = './.'
    outdir = './.'
/

&system
    ibrav = 2,
    celldm(1) = 10.5,
    nat = 3,
    ntyp = 3,
    ecutwfc = 60,
    ecutrho = 240,
    nbnd = 28,
    occupations = 'smearing'
    smearing = 'gaussian',
    degauss = 0.01
/

&electrons
    mixing_beta = 0.7
    conv_thr = 1.0d-7
    
/
ATOMIC_SPECIES
 Cu 63.546 Cu.upf
 Ni 58.693 Ni.upf
 Pt 195.08 Pt.upf

ATOMIC_POSITIONS {alat}
 Cu 0.0 0.0 0.0
 Ni 0.5 0.5 0.5
 Pt 0.25 0.25 0.25

K_POINTS (automatic) 
10 10 10 0 0 0 
